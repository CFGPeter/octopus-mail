{
  "name": "octopus-mail",
  "productName": "Octopus Mail",
  "version": "0.2.0",
  "description": "Free, local-first desktop mail client with Smart Inbox, AI, calendar and an agent CLI",
  "author": {
    "name": "Krabi",
    "url": "https://github.com/CFGPeter"
  },
  "license": "MIT",
  "homepage": "https://github.com/CFGPeter/octopus-mail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CFGPeter/octopus-mail.git"
  },
  "bugs": {
    "url": "https://github.com/CFGPeter/octopus-mail/issues"
  },
  "private": true,
  "main": "out/main/index.js",
  "type": "commonjs",
  "bin": {
    "octo": "out/cli/octo.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-cli.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs && node --test tests/calendar.test.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "icon": "node scripts/make-icons.mjs",
    "greenmail": "node scripts/greenmail.mjs",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo": "node scripts/demo.mjs app",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:server": "npm run build && node scripts/pack-server.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^1.3.0",
    "ical.js": "^2.2.1",
    "iconv-lite": "^0.7.3",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.38",
    "nodemailer": "^7.0.13",
    "tsdav": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.17",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.17",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "pl.madoctopus.octopusmail",
    "productName": "Octopus Mail",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "out/cli/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray.ico",
        "to": "tray.ico"
      },
      {
        "from": "resources/tray-unread.ico",
        "to": "tray-unread.ico"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/tray-unread.png",
        "to": "tray-unread.png"
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "resources/trayUnreadTemplate.png",
        "to": "trayUnreadTemplate.png"
      },
      {
        "from": "resources/trayUnreadTemplate@2x.png",
        "to": "trayUnreadTemplate@2x.png"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "extraFiles": [
        {
          "from": "resources/octo.cmd",
          "to": "octo.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Octopus Mail",
      "installerSidebar": "resources/installerSidebar.bmp",
      "uninstallerSidebar": "resources/installerSidebar.bmp",
      "artifactName": "Octopus-Mail-Setup-${version}.${ext}",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "pl_PL"
      ]
    },
    "protocols": [
      {
        "name": "Octopus Mail",
        "schemes": [
          "octopus-mail"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "octopus-mail",
      "icon": "resources/icon.png",
      "category": "Network;Email",
      "synopsis": "Free, local-first mail client with Smart Inbox, AI and calendar",
      "description": "Octopus Mail: IMAP/SMTP mail client with Smart Inbox, Gatekeeper, snooze, send later, AI (Ollama/Claude), CalDAV calendar, a home server and a CLI/MCP server for AI agents.",
      "mimeTypes": [
        "x-scheme-handler/octopus-mail"
      ],
      "extraFiles": [
        {
          "from": "resources/linux/octo",
          "to": "octo"
        }
      ],
      "artifactName": "Octopus-Mail-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "resources/linux/after-install.tpl",
      "afterRemove": "resources/linux/after-remove.tpl"
    },
    "copyright": "Copyright © 2026 Krabi",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Octopus-Mail-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Octopus Mail",
            "CFBundleURLSchemes": [
              "octopus-mail"
            ]
          }
        ]
      },
      "extraResources": [
        {
          "from": "resources/mac/octo",
          "to": "octo"
        }
      ]
    },
    "dmg": {
      "title": "Octopus Mail ${version}"
    }
  }
}
